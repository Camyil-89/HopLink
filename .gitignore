# Files without extensions (keep directories traversable)
*
!*.*
!*/
!LICENSE

# Windows executables
*.exe

# Text files are local data by default; only dependency manifests and examples belong in Git.
*.txt
!deploy/
deploy/*.txt.example

# Other generated binaries and build output
*.out
*.test
*.dll
*.so
*.dylib
/bin/
/dist/
/build/*
!/build/appicon.png
!/build/windows/
/build/windows/*
!/build/windows/icon.ico

# Local Go caches
.gocache/
.gomodcache/
.goappdata/
__pycache__/

# Build artifacts
/HopLink*

# Wails desktop frontend build artifacts
/internal/desktop/frontend/node_modules/
/internal/desktop/app/assets/ui/dist/
/internal/desktop/frontend/dist/
/internal/desktop/frontend/*.tsbuildinfo
/internal/desktop/frontend/package.json.md5
/internal/desktop/build/

# Local deployment secrets and client credentials
/.HopLink/
/.user_links.json
/deploy/
!/deploy/
deploy/*.txt
!deploy/*.txt.example
deploy/.user_links.json
deploy/hy2-server.crt
deploy/hy2-server.key

deploy/settings.json
deploy/map.json
